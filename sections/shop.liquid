{{ 'purelane-shop.css' | asset_url | stylesheet_tag }}

<section class="purelane sec" id="{{ section.id }}">
  <div class="wrap">

    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    {%- liquid
      assign coll = section.settings.collection
      assign limit = section.settings.products_count
    -%}

    {%- if coll != blank and coll.products.size > 0 -%}
      <div class="shelf">
        {%- for product in coll.products limit: limit -%}
          {%- liquid
            assign rv_class = 'rv'
            assign delay_index = forloop.index0 | modulo: 4
            if delay_index > 0
              assign rv_class = 'rv rv-d' | append: delay_index
            endif

            assign badge = ''
            if product.tags contains 'bestseller'
              assign badge = 'Best seller'
            elsif product.tags contains 'new'
              assign badge = 'New'
            elsif product.tags contains 'top-rated'
              assign badge = 'Top rated'
            endif

            assign rating_value = product.metafields.reviews.rating.value
            assign rating_count = product.metafields.reviews.rating_count.value
          -%}
          <article class="glass card {{ rv_class }}" {{ block.shopify_attributes }}>
            <div class="shot">
              {%- if badge != blank -%}<span class="pill">{{ badge }}</span>{%- endif -%}
              {%- if product.featured_image -%}
                <img
                  class="pimg"
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  srcset="{{ product.featured_image | image_url: width: 200 }} 200w, {{ product.featured_image | image_url: width: 400 }} 400w"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'pimg placeholder-svg' }}
              {%- endif -%}
            </div>

            <h4><a href="{{ product.url }}">{{ product.title }}</a></h4>

            {%- if rating_value != blank -%}
              <div class="rate"><b>★ {{ rating_value }}</b>{%- if rating_count != blank -%} · {{ rating_count }} reviews{%- endif -%}</div>
            {%- endif -%}

            <div class="pr">
              <strong>{{ product.price | money }}</strong>
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
                {%- assign pct_off = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                <em>{{ pct_off }}% off</em>
              {%- endif -%}
            </div>

            {%- if product.available -%}
              {%- form 'product', product, class: 'shop-add-form' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="btn btn-ghost btn-sm" name="add">
                  <span class="btn-text">Add to cart</span>
                </button>
              {%- endform -%}
            {%- else -%}
              <button type="button" class="btn btn-ghost btn-sm" disabled>Sold out</button>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="shop-empty rv">
        <p class="body-s">Select a collection in the section settings to display products here.</p>
      </div>
    {%- endif -%}

  </div>
</section>

<script src="{{ 'purelane-shop.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "purelane-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
