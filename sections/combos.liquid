{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}

<section class="purelane sec" id="{{ section.id }}">
  <div class="wrap">

    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      {%- if section.settings.lede != blank -%}<p class="lede" style="margin:14px auto 0">{{ section.settings.lede }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="comborail rv">
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            assign combo_class = 'glass combo'
            if block.settings.highlight
              assign combo_class = combo_class | append: ' hero-combo'
            endif

            assign component_count = 0
            if block.settings.component_1_product or block.settings.component_1_label != blank
              assign component_count = component_count | plus: 1
            endif
            if block.settings.component_2_product or block.settings.component_2_label != blank
              assign component_count = component_count | plus: 1
            endif
            if block.settings.component_3_product or block.settings.component_3_label != blank
              assign component_count = component_count | plus: 1
            endif
          -%}
          <article class="{{ combo_class }}" {{ block.shopify_attributes }}>
            <div class="tray">
              {%- if p and p.compare_at_price > p.price -%}
                {%- assign save_amt = p.compare_at_price | minus: p.price -%}
                <span class="save">You save {{ save_amt | money }}</span>
              {%- elsif block.settings.save_label != blank -%}
                <span class="save">{{ block.settings.save_label }}</span>
              {%- endif -%}
              {%- if block.settings.flag_text != blank -%}<span class="flag">{{ block.settings.flag_text }}</span>{%- endif -%}

              <div class="stack">
                {%- for i in (1..3) -%}
                  {%- liquid
                    case i
                      when 1
                        assign comp_product = block.settings.component_1_product
                        assign comp_label = block.settings.component_1_label
                      when 2
                        assign comp_product = block.settings.component_2_product
                        assign comp_label = block.settings.component_2_label
                      when 3
                        assign comp_product = block.settings.component_3_product
                        assign comp_label = block.settings.component_3_label
                    endcase
                  -%}
                  {%- if comp_product or comp_label != blank -%}
                    {%- if i > 1 -%}<span class="plus" aria-hidden="true">+</span>{%- endif -%}
                    <span class="it">
                      {%- if comp_product and comp_product.featured_image -%}
                        <img class="pimg" src="{{ comp_product.featured_image | image_url: width: 160 }}" width="{{ comp_product.featured_image.width }}" height="{{ comp_product.featured_image.height }}" alt="{{ comp_product.featured_image.alt | default: comp_product.title | escape }}" loading="lazy">
                      {%- else -%}
                        <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
                      {%- endif -%}
                      <span>{{ comp_label | default: comp_product.title }}</span>
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

            <div class="body">
              <h3>{{ block.settings.title | default: p.title }}</h3>
              {%- if component_count > 0 -%}<div class="cnt">{{ component_count }} products</div>{%- endif -%}
              {%- if block.settings.description != blank -%}<p class="inc">{{ block.settings.description }}</p>{%- endif -%}

              {%- if p -%}
                <div class="prow">
                  <strong>{{ p.price | money }}</strong>
                  {%- if p.compare_at_price > p.price -%}
                    <s>{{ p.compare_at_price | money }}</s>
                    {%- assign save_amt2 = p.compare_at_price | minus: p.price -%}
                    <em>Save {{ save_amt2 | money }}</em>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.fine_print != blank -%}<div class="fine">{{ block.settings.fine_print }}</div>{%- endif -%}

              {%- if p -%}
                {%- liquid
                  assign btn_class = 'btn btn-ghost'
                  if block.settings.highlight
                    assign btn_class = 'btn btn-primary'
                  endif
                -%}
                <a class="{{ btn_class }}" href="{{ p.url }}">
                  {{ block.settings.cta_label | default: 'Shop bundle' }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        Swipe for more combos
      </div>
      {%- if section.settings.rail_note != blank -%}<p class="railnote">{{ section.settings.rail_note }}</p>{%- endif -%}
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "purelane-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "textarea",
      "id": "rail_note",
      "label": "Note below the rail",
      "default": "Tapping \"Shop bundle\" takes you straight to that bundle's product page — you can review everything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Bundle product",
          "info": "Price, compare-at price and the \"Shop bundle\" link all come from this product."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override",
          "info": "Leave blank to use the product's own title"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight this combo (accent border + primary button)",
          "default": false
        },
        {
          "type": "text",
          "id": "flag_text",
          "label": "Corner flag (optional)",
          "info": "e.g. \"Most popular\" or \"Best value\""
        },
        {
          "type": "text",
          "id": "save_label",
          "label": "Save label override",
          "info": "Only used if the product has no compare-at price set"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "Fine print",
          "default": "Inclusive of all taxes · COD available"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop bundle"
        },
        {
          "type": "header",
          "content": "Component 1"
        },
        {
          "type": "product",
          "id": "component_1_product",
          "label": "Product (for image)"
        },
        {
          "type": "text",
          "id": "component_1_label",
          "label": "Caption",
          "info": "Leave blank to use the product's title"
        },
        {
          "type": "header",
          "content": "Component 2"
        },
        {
          "type": "product",
          "id": "component_2_product",
          "label": "Product (for image)"
        },
        {
          "type": "text",
          "id": "component_2_label",
          "label": "Caption"
        },
        {
          "type": "header",
          "content": "Component 3"
        },
        {
          "type": "product",
          "id": "component_3_product",
          "label": "Product (for image)"
        },
        {
          "type": "text",
          "id": "component_3_label",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos",
      "blocks": [
        { "type": "combo" },
        { "type": "combo" },
        { "type": "combo" }
      ]
    }
  ]
}
{% endschema %}
