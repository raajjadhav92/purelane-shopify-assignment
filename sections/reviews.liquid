{{ 'purelane-reviews.css' | asset_url | stylesheet_tag }}

<section class="purelane sec revband" id="{{ section.id }}">
  <div class="wrap">
    <div class="revhead rv">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <span class="agg"><span class="st">★★★★★</span> <b>{{ section.settings.rating_value }}</b> {{ section.settings.rating_text }}</span>
      {%- endif -%}
      {%- if section.settings.homes_text != blank -%}<span class="agg">{{ section.settings.homes_text }}</span>{%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="revrail rv" aria-label="Customer reviews">
      <div class="revtrack">
        {%- comment -%} Render blocks twice back-to-back for a seamless CSS marquee loop {%- endcomment -%}
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign stars = block.settings.rating | default: 5
            -%}
            <article class="glass-2 rcard" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %} {% if i == 2 %}aria-hidden="true"{% endif %}>
              <div class="st">{% for s in (1..stars) %}★{% endfor %}</div>
              {%- if block.settings.headline != blank -%}<h5>{{ block.settings.headline }}</h5>{%- endif -%}
              {%- if block.settings.quote != blank -%}<p>{{ block.settings.quote }}</p>{%- endif -%}
              <div class="who">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                {%- if block.settings.author != blank -%}<b>{{ block.settings.author }}</b>{%- endif -%}
                {%- if block.settings.product %}<span>· {{ block.settings.product.title }}</span>
                {%- elsif block.settings.product_label != blank -%}<span>· {{ block.settings.product_label }}</span>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "purelane-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Average rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "homes_text",
      "label": "Secondary stat",
      "default": "Loved by 12 lakh+ homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Verified buyer"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product reviewed (optional)",
          "info": "Links the review to a real product. Leave blank to use the text label below instead."
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product label override",
          "info": "Only used if no product is selected above"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
